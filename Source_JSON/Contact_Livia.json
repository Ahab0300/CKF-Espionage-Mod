	"Dialog": [
		{
			"GroupId": "D_AhabEspionage_UNAAgent_Start",
			"Items": [
				{"Actor": "NCT_AhabEspionage_UNAAgent_Intro", "Target": "NCT_AhabEspionage_UNAAgent", "Side": "R", "Text": "I've noticed {4} visiting the club for weeks now."},
				{"Actor": "PCP_Face", "Target": "NCT_AhabEspionage_UNAAgent", "Text": "Is {3} becoming a problem for you?"},
				{"Actor": "NCT_AhabEspionage_UNAAgent_Intro", "Target": "NCT_AhabEspionage_UNAAgent", "Side": "R", "Text": "No, {3} has been behaving extremely well. Socializing, not drinking to excess, casually making friends."},
				{"Actor": "NCT_AhabEspionage_UNAAgent_Intro", "Target": "NCT_AhabEspionage_UNAAgent", "Side": "R", "Text": "What drew my attention is how {3} quietly sought out rumors and stories from the other patrons."},
				{"Actor": "NCT_AhabEspionage_UNAAgent_Intro", "Target": "NCT_AhabEspionage_UNAAgent", "Side": "R", "Text": "Last night {3} finally approached me, asking about a style=DialogTerm>Cyber Knight</style>. I think you will want to talk to {1}."},
				{"Actor": "PCP_Knight", "Target": "NCT_AhabEspionage_UNAAgent", "Text": "Interesting. Go ahead and connect us with {4}."},
				{"Actor": "NCT_AhabEspionage_UNAAgent", "Side": "R", "Text": "Finally I get to meet you. I've been tracking rumors of a <style=DialogTerm>Cyber Knight</style> across the city."},
				{"Actor": "NCT_AhabEspionage_UNAAgent", "Side": "R", "Text": "I've done a lot of research about you and your team."},
				{"Actor": "NCT_AhabEspionage_UNAAgent", "Side": "R", "Text": "I think you and I can do some business together."},
				{"Actor": "PCP_Knight", "Text": "We're always interested in business. Just what is your business?"},
				{"Actor": "NCT_AhabEspionage_UNAAgent", "Side": "R", "Text": "I work for the United North American government. Intelligence division."},
				{"Actor": "PCP_Face", "Text": "A UNA spy?"},
				{"Actor": "NCT_AhabEspionage_UNAAgent", "Side": "R", "Text": "As you say. Our job is to keep a close eye on the megacorporations."},
				{"Actor": "NCT_AhabEspionage_UNAAgent", "Side": "R", "Text": "They are constantly pushing the limits of the New Boston Zone Charter."},
				{"Actor": "NCT_AhabEspionage_UNAAgent", "Side": "R", "Text": "They seek advantage over each other in legal and less legal ways. We're lucky they don't break into open warfare more often than they do."},
				{"Actor": "NCT_AhabEspionage_UNAAgent", "Side": "R", "Text": "They try to keep the UNA out of their business, and keep us as weak as possible."},
				{"Actor": "NCT_AhabEspionage_UNAAgent", "Side": "R", "Text": "We have a lot of difficulty getting accurate intelligence on what is going on, and our budget is always in danger."},
				{"Actor": "NCT_AhabEspionage_UNAAgent", "Side": "R", "Text": "Occasionally, I find I could use an outside party for clandestine missions. A <style=DialogTerm>Cyber Knight</style> would be a good asset for such jobs."},
				{"Actor": "PCP_Knight", "Text": "You want deniability. They won't know it was you behind the job."},
				{"Actor": "NCT_AhabEspionage_UNAAgent", "Side": "R", "Text": "We understand each other."},
				{"Actor": "NCT_AhabEspionage_UNAAgent", "Side": "R", "Text": "In addition to the occasional job, I can offer certain tools which can help in your stealthy operations."},
				{"Actor": "PCP_Knight", "Text": "This sounds interesting. Let us know if you have a job to offer."},
				{"Actor": "NAR_", "Target": "NCT_AhabEspionage_UNAAgent", "Text": "We can find {1} in our Contact list to check out what additional services and offerings {3} may be able to provide."}
			]
		}
	],
