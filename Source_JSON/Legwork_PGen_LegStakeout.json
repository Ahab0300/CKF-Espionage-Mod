    "Dialog": [
        {
            "GroupId": "D_LegStakeout_Intro",
            "Items": [
                {
                    "Actor": "PCP_Knight",
                    "Target": "NCT_LegStakeout",
                    "Text": "Stakeouts are long and boring. What makes this building interesting?"
                },
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "InterpolateId": "EQL_1_S_LegStakeout_Type",
                    "Text": "The target is a laboratory of some interest to us."
                },
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "InterpolateId": "EQL_2_S_LegStakeout_Type",
                    "Text": "We have detected some suspictious activity at the location."
                },
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "InterpolateId": "EQL_3_S_LegStakeout_Type",
                    "Text": "A rival gang is using it for a meeting space."
                },
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "InterpolateId": "EQL_4_S_LegStakeout_Type",
                    "Text": "Someone is smuggling materials through a warehouse without our permission and I would like to know who it is"
                },
                {
                    "Actor": "PCP_Face",
                    "Side": "R",
                    "Text": "What would you like us to do?"
                },
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "InterpolateId": "EQL_1_S_LegStakeout_Type",
                    "Text": "Keep track of who is going in and out, and the deliveries to and from the lab."
                },
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "InterpolateId": "EQL_2_S_LegStakeout_Type",
                    "Text": "If anyone goes in there, we want to know."
                },
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "InterpolateId": "EQL_3_S_LegStakeout_Type",
                    "Text": "Figure out when they are meeting, and who is attending."
                },
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "InterpolateId": "EQL_4_S_LegStakeout_Type",
                    "Text": "Look for any suspicious shipments out of the warehouse."
                },
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "Text": "Set up an observation post. Keep watch on the building. Write down everything that happens there."
                }
            ]
        },
        {
            "GroupId": "Dialog.D_LegStakeout_LegStart",
            "Items": [
                {
                    "Actor": "PLG_LegStakeout",
                    "Quip": "ProcLeg_LegStakeout_Start",
                    "Side": "R",
                    "Text": "{11}"
                },
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "Text": "Just watch the building and pay attention."
                },
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "Text": "Remember this has to be covert. Set up your observation post carefully so they won't see you."
                }
            ]
        },
        {
            "GroupId": "D_LegStakeout_Chat1",
            "Items": [
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "InterpolateId": "EQL_1_S_LegStakeout_Type",
                    "Text": "If we know who is working there, we can figure out what they are working on."
                },
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "InterpolateId": "EQL_2_S_LegStakeout_Type",
                    "Text": "It's probably just a hideout for some Gray Card criminals, but it could be something more."
                },
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "InterpolateId": "EQL_3_S_LegStakeout_Type",
                    "Text": "They seem to meet there regularly but I don't know whether it is high-level or low-level people."
                },
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "InterpolateId": "EQL_4_S_LegStakeout_Type",
                    "Text": "I don't know who is doing the smuggling. Pinning down the shipments will help me figure it out."
                }
            ]
        },
        {
            "GroupId": "D_LegStakeout_Chat2",
            "Items": [
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "Text": "A week should be enough to get the information I need."
                },
                {
                    "Actor": "PCP_Face",
                    "Side": "R",
                    "Text": "A week sitting in one place watching a building. What if we are 'made' and they notice our observation?"
                },
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "Text": "Have a good escape route. They'll probably send a squad of guards after you."
                }
            ]
        },
        {
            "GroupId": "D_LegStakeout_Delayed",
            "Items": [
                {
                    "Actor": "NCT_LegStakeout",
                    "Target": "PCP_Knight",
                    "Side": "R",
                    "Quip": "ProcLeg_Generic_DelayDialog",
                    "Text": "{11}"
                }
            ]
        },
        {
            "GroupId": "D_LegStakeout_Reject",
            "Items": [
                {
                    "Actor": "NCT_LegStakeout",
                    "Target": "PCP_Knight",
                    "Side": "R",
                    "Quip": "ProcLeg_Generic_RejectDialog",
                    "Text": "{11}"
                }
            ]
        },
        {
            "GroupId": "D_LegStakeout_Win",
            "Items": [
                {
                    "Actor": "PTG_LegMem_LegStakeout",
                    "Target": "NCT_LegStakeout",
                    "Side": "R",
                    "Text": "I found a good observation post and spent a nice quiet week watching the place."
                },
                {
                    "Actor": "PTG_LegMem_LegStakeout",
                    "Target": "NCT_LegStakeout",
                    "Side": "R",
                    "Text": "There were lots of people in and out regularly."
                },
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "InterpolateId": "EQL_1_S_LegStakeout_Type",
                    "Text": "Interesting list of researchers you have here. Thank you."
                },
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "InterpolateId": "EQL_2_S_LegStakeout_Type",
                    "Text": "We'll use this to make a small raid and clear the place out."
                },
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "InterpolateId": "EQL_3_S_LegStakeout_Type",
                    "Text": "It's good to keep tabs on the other gangs."
                },
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "InterpolateId": "EQL_4_S_LegStakeout_Type",
                    "Text": "Several interesting shipments, I see. I will follow up on these clues."
                },
                {
                    "Actor": "NAR_",
                    "Target": "NCT_LegStakeout",
                    "Quip": "Generic_Legwork_InfluenceAndFavor",
                    "Text": "{11}"
                }
            ]
        },
        {
            "GroupId": "D_LegStakeout_Loss",
            "Items": [
                {
                    "Actor": "PCP_Face",
                    "Side": "R",
                    "Target": "PTG_LegMem_LegStakeout",
                    "Text": "{1} is back in a rush. You should come talk to {4}."
                },
                {
                    "Actor": "PCP_Knight",
                    "Text": "What happened out on the Stakeout?"
                },
                {
                    "Actor": "PTG_LegMem_LegStakeout",
                    "Side": "R",
                    "Quip": "ProcLeg_LegStakeout_Loss1",
                    "Text": "{11}"
                },
                {
                    "Actor": "PTG_LegMem_LegStakeout",
                    "Side": "R",
                    "Text": "I barely got away before they swarmed the place."
                },
                {
                    "Actor": "NCT_LegStakeout",
                    "Side": "R",
                    "Text": "I told you to be careful! This will make things harder - the Heat is on."
                },
                {
                    "Actor": "NAR_",
                    "Target": "PTG_LegMem_LegStakeout",
                    "Text": "We have gained <style=DialogTerm>+20% Heat</style> for failing this <style=DialogTerm>Legwork</style>."
                }
            ]
        }
    ],
    "DialogQuip": [
        {
            "GroupId": "ProcLeg_LegStakeout_Start",
            "Items": [
                {"Text": "A Stakeout? I see a lot of takeout food in my future."},
                {"Text": "All I have to do is sit around for a week? Vacation"},
                {"Text": "I hate just sitting on stakeout all day."}
            ]
        },
        {
            "GroupId": "ProcLeg_LegStakeout_Loss1",
            "Items": [
                {"Text": "I'm not sure how they spotted me. The operation was going quietly when suddenly guards were everywhere."},
                {"Text": "They were on alert the entire time I was there. I tried several times to find an observation post but had to abandon them all."},
                {"Text": "My observation post was great. It had a perfect view of the site. Which is why they posted a sniper on the roof shortly after I arrived."}
            ]
        }
    ],
