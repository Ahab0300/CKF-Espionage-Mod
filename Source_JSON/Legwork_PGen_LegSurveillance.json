    "Dialog": [
        {
            "GroupId": "D_AhabEspionage_LegSurveillance_Intro",
            "Items": [
                {
                    "Actor": "PCP_Knight",
                    "Target": "NCT_AhabEspionage_LegSurveillance",
                    "Text": "Surveillance is tricky, {1}. Who is the target?"
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "PreState1": "EQL_1_S_AhabEspionage_LegSurveillance_Type",
                    "Text": "This is a person of interest, a potential asset we may cultivate."
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "PreState1": "EQL_2_S_AhabEspionage_LegSurveillance_Type",
                    "Text": "My investigation points to this suspect, but I want to go after whoever they are working with."
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "PreState1": "EQL_3_S_AhabEspionage_LegSurveillance_Type",
                    "Text": "They may be a rat and I want to sniff them out."
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "PreState1": "EQL_4_S_AhabEspionage_LegSurveillance_Type",
                    "Text": "I think they are a traitor but I need evidence."
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "PreState1": "EQL_5_S_AhabEspionage_LegSurveillance_Type",
                    "Text": "My internal investigation has been very quiet, but I can't use anyone they might recognize."
                },
                {
                    "Actor": "PCP_Face",
                    "Side": "R",
                    "Text": "What can we expect from this person?"
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "PreState1": "EQL_1_S_AhabEspionage_LegSurveillance_Type",
                    "Text": "The target should not expect anything, but don't get careless."
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "PreState1": "EQL_2_S_AhabEspionage_LegSurveillance_Type",
                    "Text": "The suspect may be cautious, so be careful."
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "PreState1": "EQL_3_S_AhabEspionage_LegSurveillance_Type",
                    "Text": "Be careful, I don't want the rat scurrying down a hole."
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "PreState1": "EQL_4_S_AhabEspionage_LegSurveillance_Type",
                    "Text": "I will keep up appearances while you gather the evidence."
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "PreState1": "EQL_5_S_AhabEspionage_LegSurveillance_Type",
                    "Text": "The investigation is going well, so don't mess it up by being spotted."
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "Text": "Don't get too close. Just keep well back and watch what they do."
                }
            ]
        },
        {
            "GroupId": "D_AhabEspionage_LegSurveillance_LegStart",
            "Items": [
                {
                    "Actor": "PLG_AhabEspionage_LegSurveillance",
                    "Quip": "ProcLeg_AhabEspionage_LegSurveillance_Start",
                    "Side": "R",
                    "Text": "{11}"
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "Text": "Just follow them and pay attention."
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "Text": "Remember this has to be covert. Just act normal and don't let them spot you."
                }
            ]
        },
        {
            "GroupId": "D_AhabEspionage_LegSurveillance_Chat1",
            "Items": [
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "PreState1": "EQL_1_S_AhabEspionage_LegSurveillance_Type",
                    "Text": "They are a mid-level asset, no bodyguards, only modest security protocols."
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "PreState1": "EQL_2_S_AhabEspionage_LegSurveillance_Type",
                    "Text": "It's just a lowlife with connections. It shouldn't be a problem."
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "PreState1": "EQL_3_S_AhabEspionage_LegSurveillance_Type",
                    "Text": "A rat may have some cunning, but they're just a rat."
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "PreState1": "EQL_4_S_AhabEspionage_LegSurveillance_Type",
                    "Text": "They don't have any special training, if that's what you are asking."
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "PreState1": "EQL_5_S_AhabEspionage_LegSurveillance_Type",
                    "Text": "They're just a cog in the wheel, they should not have anything special."
                }
            ]
        },
        {
            "GroupId": "D_AhabEspionage_LegSurveillance_Chat2",
            "Items": [
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "Text": "A week should be enough to get the information I need."
                },
                {
                    "Actor": "PCP_Face",
                    "Side": "R",
                    "Text": "That's a long time to avoid being spotted. What if we are 'made' and they notice the tail?"
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "Text": "You'll have to give up then. They will be watching for you after that, so don't let it happen."
                }
            ]
        },
        {
            "GroupId": "D_AhabEspionage_LegSurveillance_Delayed",
            "Items": [
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Target": "PCP_Knight",
                    "Side": "R",
                    "Quip": "ProcLeg_Generic_DelayDialog",
                    "Text": "{11}"
                }
            ]
        },
        {
            "GroupId": "D_AhabEspionage_LegSurveillance_Reject",
            "Items": [
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Target": "PCP_Knight",
                    "Side": "R",
                    "Quip": "ProcLeg_Generic_RejectDialog",
                    "Text": "{11}"
                }
            ]
        },
        {
            "GroupId": "D_AhabEspionage_LegSurveillance_Win",
            "Items": [
                {
                    "Actor": "PTG_LegMem_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "Text": "That went smooth as silk. Here's the surveillance observations you wanted."
                },
                {
                    "Actor": "PTG_LegMem_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "Text": "They never noticed a thing."
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "PreState1": "EQL_1_S_AhabEspionage_LegSurveillance_Type",
                    "Text": "Thank you, this will help us figure out how to handle this asset."
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "PreState1": "EQL_2_S_AhabEspionage_LegSurveillance_Type",
                    "Text": "Good. We'll prepare to move in on the suspects."
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "PreState1": "EQL_3_S_AhabEspionage_LegSurveillance_Type",
                    "Text": "The little rat will get what's coming for them."
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "PreState1": "EQL_4_S_AhabEspionage_LegSurveillance_Type",
                    "Text": "I'll handle it from here. Thank you."
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "PreState1": "EQL_5_S_AhabEspionage_LegSurveillance_Type",
                    "Text": "This will help our investigation a lot."
                },
                {
                    "Actor": "NAR_",
                    "Target": "NCT_AhabEspionage_LegSurveillance",
                    "Quip": "Generic_Legwork_InfluenceAndFavor",
                    "Text": "{11}"
                }
            ]
        },
        {
            "GroupId": "D_AhabEspionage_LegSurveillance_Loss",
            "Items": [
                {
                    "Actor": "PCP_Face",
                    "Side": "R",
                    "Target": "PTG_LegMem_AhabEspionage_LegSurveillance",
                    "Text": "{1} is back but you'd better come talk to {4}."
                },
                {
                    "Actor": "PCP_Knight",
                    "Text": "What happened out on the surveillance?"
                },
                {
                    "Actor": "PTG_LegMem_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "Quip": "ProcLeg_AhabEspionage_LegSurveillance_Loss1",
                    "Text": "{11}"
                },
                {
                    "Actor": "PTG_LegMem_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "Text": "They spotted me and slipped away. There was no point continuing the tail."
                },
                {
                    "Actor": "NCT_AhabEspionage_LegSurveillance",
                    "Side": "R",
                    "Text": "I told you to be careful! This will make things harder - the Heat is on."
                },
                {
                    "Actor": "NAR_",
                    "Target": "PTG_LegMem_AhabEspionage_LegSurveillance",
                    "Text": "We have gained <style=DialogTerm>+20% Heat</style> for failing this <style=DialogTerm>Legwork</style>."
                }
            ]
        }
    ],
    "DialogQuip": [
        {
            "GroupId": "ProcLeg_AhabEspionage_LegSurveillance_Start",
            "Items": [
                {"Text": "I hate surveillance. You have to be on your toes all the time."},
                {"Text": "Can I wear a disguise? Where's my trenchcoat?"},
                {"Text": "'It was another rainy day in the Zone. I pulled down my fedora and followed a little closer.'"},
                {
                    "Tag": "Trait_Sleuth",
                    "Text": "I haven't been on surveillance in a long time."
                }
            ]
        },
        {
            "GroupId": "ProcLeg_AhabEspionage_LegSurveillance_Loss1",
            "Items": [
                {"Text": "I thought I was keeping far enough back, but I must have slipped up."},
                {"Text": "The target was better trained than you led me to believe! They know some tradecraft."},
                {"Text": "It was a fluke. Some chummers got into a drunken fight in front of me and drew attention."}
            ]
        }
    ],
